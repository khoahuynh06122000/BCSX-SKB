# ---------------------------------------------------------------------------
# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Service-role key: CHỈ dùng ở server (server.ts) cho việc quản lý user (tạo/xoá/đổi role).
# TUYỆT ĐỐI không để lộ ra client / không thêm tiền tố VITE_.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Cloudinary (Dashboard -> Product Environment Credentials + Settings -> Upload)
# Tạo một "unsigned" upload preset rồi điền tên preset vào đây.
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
VITE_CLOUDINARY_UPLOAD_PRESET="YOUR_UNSIGNED_UPLOAD_PRESET"

# Gemini (giữ nguyên — dùng cho tính năng quét phiếu xuất bằng AI ở server.ts)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
