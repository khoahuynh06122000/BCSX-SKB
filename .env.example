# ---------------------------------------------------------------------------
# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
# ---------------------------------------------------------------------------

# Cloudinary — nơi lưu ảnh biên bản/minh chứng.
# Dashboard -> lấy Cloud name; Settings -> Upload -> tạo một Upload preset dạng "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
VITE_CLOUDINARY_UPLOAD_PRESET="YOUR_UNSIGNED_UPLOAD_PRESET"

# Gemini — dùng cho tính năng quét phiếu chuyển bộ phận bằng AI (server.ts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Ghi chú: cấu hình kết nối Firebase nằm ở file firebase-applet-config.json
# (thư mục gốc dự án), không phải ở đây.
