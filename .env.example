# ---------------------------------------------------------------------------
# Chay tai may: sao chep file nay thanh .env.local roi dien gia tri that.
# Deploy len Vercel: vao Project -> Settings -> Environment Variables,
#                    dan nguyen noi dung (Vercel ho tro dan hang loat).
# KHONG commit file .env.local.
# ---------------------------------------------------------------------------

# --- Firebase ---------------------------------------------------------------
# Lay tai: Firebase Console -> Project settings (banh rang) -> muc "Your apps"
# -> "SDK setup and configuration" -> chon "Config".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# De trong neu dung database mac dinh.
VITE_FIREBASE_DATABASE_ID=(default)

# --- Cloudinary (luu anh minh chung) ----------------------------------------
# Cloud name: lay o Dashboard.
# Upload preset: Settings -> Upload -> Upload presets -> tao preset "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Gemini (quet phieu chuyen bo phan bang AI) -----------------------------
# KHONG co tien to VITE_ => chi may chu doc duoc, khong lot ra trinh duyet.
GEMINI_API_KEY=
