rules_version = '2';

// =============================================================================
// QUY TAC PHAN QUYEN - BiaLogistics (Paperless 2-Gate Brewery -> Warehouse)
//
// Nguyen tac cot loi: KHONG BAO GIO quyet dinh quyen dua tren tai lieu ma
// chinh nguoi dung ghi duoc.
//
// Ban cu pham dung loi nay: ham isOwner() doc vai tro tu user_sessions/{uid},
// ma tai lieu do lai cho phep chinh nguoi dung ghi -> ai cung tu phong minh
// lam OWNER duoc. Ban nay xac dinh chu so huu bang EMAIL trong ID token do
// Google cap, khong the gia mao.
// =============================================================================
//
// =============================================================================
// Assumed Data Model
// =============================================================================
//
// Collection: users/{uid}
// Fields:
//   - uid: string (required on create, == auth.uid, <= 128, immutable)
//   - email: string (required on create, == auth email, <= 254, immutable)
//   - role: string (required, 'PENDING' on create; one of OWNER, KE_TOAN,
//     QUAN_LY_XUONG, SAN_XUAT, NHAP_KHO, XUAT_KHO, DNC, PENDING)
//   - name: string|null (optional, <= 200)
//   - photoURL: string|null (optional, <= 2000)
//   - createdAt: string|null (optional, <= 64)
//   - updatedAt: string|null (optional, <= 64)
//   - approvedBy: string|null (optional, <= 254)
//   - pinHash: string|null (optional, <= 512)
//   - pinSalt: string|null (optional, <= 128)
//   - pinUpdatedAt: string|null (optional, <= 64)
//   - pinFailCount: number|null (optional, 0..5)
//   - pinLocked: bool|null (optional)
//   - pinMustChange: bool|null (optional)
//
// Collection: slips/{slipId} (Document ID = code, e.g. PN-YYMMDD-NN)
// Fields:
//   - id: string (optional, == slipId, <= 64, immutable)
//   - code: string (required on create, == slipId, <= 64, immutable)
//   - date: string (required on create, yyyy-MM-dd, <= 32)
//   - dateKey: string|null (optional, <= 32)
//   - seq: number|null (optional, 0..100000)
//   - status: string (required, in ['draft', 'printed', 'cho_ql_xuong',
//     'cho_kho_tong', 'tra_lai', 'signed'])
//   - printedAt, signedAt, createdAt, updatedAt, rejectedAt: string|null (<= 64)
//   - signedBy, rejectedBy: string|null (<= 254)
//   - createdBy, updatedBy: string|null (<= 150)
//   - note: string|null (<= 2000)
//   - rejectedReason: string|null (<= 2000)
//   - creatorSig, managerSig, warehouseSig: map|null (ChuKyDienTu:
//     { name, email, uid?, signedAt, token, note? })
//   - FORBIDDEN: signedPhotoUrls (images live only in anh_chung_tu)
//
// Collection: ke_hoach_sx/{planId}
// Fields:
//   - id: string|null (optional, <= 128, immutable if set)
//   - date: string (required, yyyy-MM-dd..., 8..32)
//   - productId: string (required, 1..64)
//   - targetQty: number (required, 0..10000000)
//   - batchHint: string|null (optional, <= 128)
//   - source: string (required, 0..128)
//   - note: string|null (optional, <= 2000)
//   - createdBy: string (required, 1..150)
//   - createdAt: string (required, 1..64)
//   - updatedAt: string|null (optional, <= 64)
//   - updatedBy, uid, productName, unit, published (optional bounded fields)
//
// Collection: danh_gia_sx/{evalId}
// Fields:
//   - id: string|null (optional, <= 128, immutable if set)
//   - date: string (required, yyyy-MM-dd..., 8..32)
//   - shift: string (required, 1..100)
//   - productId: string (required, 1..64)
//   - plannedQty: number (required, 0..10000000)
//   - actualBrewedQty: number (required, 0..10000000)
//   - actualHandoverQty, lossQty: number|null (optional, 0..10000000)
//   - rating: string (required, 1..100)
//   - note: string (required, 0..2000)
//   - createdBy: string (required, 0..150)
//   - createdAt: string (required, 1..64)
//   - updatedAt, updatedBy, uid, productName, unit (optional bounded fields)
//   - approvalStatus: string|null (optional, in ['pending', 'approved', 'returned'])
//   - approvedBy: string|null (optional, <= 150)
//   - approvedAt: string|null (optional, <= 64)
//   - rejectedReason: string|null (optional, <= 500)
//
// Collection: kiem_ke_bon/{invId}
// Fields:
//   - id: string|null (optional, <= 128, immutable if set)
//   - month: string (required, yyyy-MM..., 6..20)
//   - tankId: string (required, 1..64)
//   - tankGroup: string (required, in ['FST', 'BBT'])
//   - productId: string (required, 1..64)
//   - batchNumber: string (required, 0..128)
//   - liters: number (required, 0..1000000)
//   - statusLabel: string|null (optional, <= 200)
//   - createdBy: string (required, 0..150)
//   - createdAt: string (required, 1..64)
//   - updatedAt, updatedBy, uid, note, productName, tankName (optional bounded)
//   - approvalStatus: string|null (optional, in ['pending', 'approved', 'returned'])
//   - approvedBy: string|null (optional, <= 150)
//   - approvedAt: string|null (optional, <= 64)
//   - rejectedReason: string|null (optional, <= 500)
//
// Collection: kiem_ke_keg/{invId}
// Fields:
//   - id: string|null (optional, <= 128, immutable if set)
//   - date: string (required, yyyy-MM-dd..., 8..32)
//   - shiftOrPeriod: string|null (optional, <= 100)
//   - location: string (required, in ['XUONG', 'KHO_TONG'])
//   - items: list (required, 1..100)
//   - totalKegs: number (required, 0..1000000)
//   - totalLiters: number (required, 0..10000000)
//   - note: string|null (optional, <= 2000)
//   - createdBy: string (required, 0..150)
//   - createdAt: string (required, 1..64)
//   - updatedAt, updatedBy, uid (optional bounded)
//   - approvalStatus: string|null (optional, in ['pending', 'approved', 'returned'])
//   - approvedBy: string|null (optional, <= 150)
//   - approvedAt: string|null (optional, <= 64)
//   - rejectedReason: string|null (optional, <= 500)
//
// Existing Collections (preserved intact):
//   - test/connection, transactions, revenue, sap_jobs, diem_ban, hoa_don,
//     anh_chung_tu, anh_minh_chung, do_luong, partners, so_phieu, bo_dem
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Email cua chu so huu. Chi tai khoan Google nay moi duyet duoc nguoi dung.
    function ownerEmail() {
      return 'khoa.huynh.06.12.2000@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.get('email', '');
    }

    // Bat buoc email da xac minh: chan truong hop tao tai khoan voi email
    // nguoi khac ma chua chung minh quyen so huu hop thu.
    function emailVerified() {
      return request.auth.token.get('email_verified', false);
    }

    // Phien dang nhap Google moi trong vong 10 phut (600 giay): bat buoc khi
    // nguoi dung tu doi PIN da co hoac tu mo khoa tai khoan bi khoa PIN.
    function hasFreshGoogleAuth() {
      return isSignedIn()
        && 'auth_time' in request.auth.token
        && request.auth.token.auth_time is int
        && request.time.toMillis() <= (request.auth.token.auth_time + 600) * 1000;
    }

    // Chu so huu GOC - xac dinh bang email trong ID token do Google cap, khong
    // the gia mao. Day la tai khoan khong bao gio bi khoa ra ngoai duoc.
    function isBootstrapOwner() {
      return isSignedIn() && emailVerified() && email() == ownerEmail();
    }

    // Chu so huu = chu so huu goc, HOAC nguoi duoc dat vai tro OWNER trong
    // users/{uid}.
    //
    // Doc vai tro tu tai lieu nguoi dung nghe giong dung cai loi ban cu mac
    // phai, nhung KHAC HAN o mot diem quyet dinh: users/{uid} khong phai tai
    // lieu chinh nguoi dung ghi duoc vai tro. Xem lai luat ben duoi:
    //   - create bat buoc role == 'PENDING'
    //   - update cua chinh minh chi cham duoc pinHash/pinUpdatedAt va bat buoc
    //     giu nguyen role
    // Nen chi chu so huu moi nang vai tro cho nguoi khac duoc. Ban cu doc tu
    // user_sessions/{uid} - tai lieu ma ai cung tu ghi de len duoc - do moi la
    // cho hong.
    function isOwner() {
      return isBootstrapOwner() ||
        (isSignedIn() && emailVerified() && role() == 'OWNER');
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'PENDING')
        : 'PENDING';
    }

    // -------------------------------------------------------------------------
    // CANH CUA THAT SU LA BUOC DUYET.
    //
    // Tai khoan Google nao cung dang nhap duoc, nhung vao thi o trang thai
    // PENDING va PENDING KHONG doc ghi duoc gi ca - phai co chu so huu bam
    // duyet. Ai bo canh cua do thi ca the gioi ghi duoc vao so kho nay.
    //
    // HAI VIEC VAN RIENG CHU SO HUU, co y giu lai:
    //   - Doi vai tro nguoi dung: mo ra thi nguoi vua duoc duyet lai di duyet
    //     nguoi khac, canh cua duy nhat con lai tu no mo toang.
    //   - Xoa du lieu: sai mot lan la mat, khong lay lai duoc.
    // -------------------------------------------------------------------------

    // Da duoc duyet: xem duoc it nhat mot phan du lieu.
    // Bao gom QUAN_LY_XUONG (duyet Rao 1 & Ke hoach SX) va SAN_XUAT (lap phieu
    // giao bia, danh gia ngay, kiem ke bon FST/BBT).
    function isApproved() {
      return isOwner() ||
        (isSignedIn() &&
          (role() == 'KE_TOAN' || role() == 'QUAN_LY_XUONG' ||
           role() == 'SAN_XUAT' || role() == 'NHAP_KHO' ||
           role() == 'XUAT_KHO' || role() == 'DNC'));
    }

    // -------------------------------------------------------------------------
    // PHAN QUYEN THEO CHIEU VA QUY TRINH 2 RAO XUONG -> KHO TONG
    //
    // NHAP_KHO chi ghi duoc chieu nhap (duyet Rao 2), XUAT_KHO chi ghi duoc
    // chieu xuat. QUAN_LY_XUONG duyet Rao 1 va lap Ke hoach SX; SAN_XUAT lap
    // phieu giao bia, danh gia ngay, kiem ke bon. Tat ca vai tro trong kho/xuong
    // VAN XEM DUOC HET qua xemKho().
    //
    // DNC chi XEM, va chi xem chieu xuat - vai tro duy nhat bi chan ca phan xem.
    //
    // Phai khop dung voi src/lib/quyen.ts - do la bang giao dien dung de an hien
    // nut. Lech ben nao cung sinh loi.
    // -------------------------------------------------------------------------

    // Ghi duoc CA HAI CHIEU: chu so huu va ke toan.
    //
    // Hai vai tro cu STAFF va VIEWER da bo ngay 30/08/2026 (khong tai khoan nao
    // mang chung). Tai khoan nao con mang mot trong hai ten do se roi vao dien
    // chua duyet - dung nhu y do.
    function isToanQuyenKho() {
      return isOwner() || (isSignedIn() && role() == 'KE_TOAN');
    }

    // DNC - khoi cung ung. CHI XEM, va chi xem du lieu chieu xuat.
    //
    // DNC nhan hoa don bia tu kho tong roi xuat tiep cho tung don vi, nen phai
    // doi chieu lai don hang va bien ban giao nhan. Nhung so ton va so nhap cua
    // kho tong khong phai viec cua ho.
    function laDNC() {
      return isSignedIn() && role() == 'DNC';
    }

    // Xem duoc du lieu KHO: ton kho, nhap kho, phieu nhap, bao cao, ke hoach,
    // danh gia, kiem ke bon. Moi vai tro da duyet TRU DNC.
    function xemKho() {
      return isApproved() && !laDNC();
    }

    // Duyet Rao 1 (xuat xuong) va quan ly Ke hoach san xuat.
    function duyetXuong() {
      return isToanQuyenKho() || (isSignedIn() && role() == 'QUAN_LY_XUONG');
    }

    // Duyet Rao 2 (kho tong xac nhan nhan bia vao ton kho).
    function duyetKhoTong() {
      return isToanQuyenKho() || (isSignedIn() && role() == 'NHAP_KHO');
    }

    // Ghi duoc chieu NHAP: nhap kho, ton dau ky, phieu nhap, danh gia san
    // xuat, kiem ke bon, va anh chung tu chieu nhap.
    function ghiNhapKho() {
      return isToanQuyenKho() ||
        (isSignedIn() &&
          (role() == 'NHAP_KHO' || role() == 'QUAN_LY_XUONG' || role() == 'SAN_XUAT'));
    }

    // Phieu nhap da ky chua (= da qua Rao 2 / co anh ky, hang da vao ton kho).
    // Trang thai 'signed' ghi CUNG LO voi anh ky o bang anh_chung_tu (hoac
    // duyet Rao 2 voi warehouseSig).
    function phieuDaKy(code) {
      return exists(/databases/$(database)/documents/slips/$(code))
        && get(/databases/$(database)/documents/slips/$(code))
             .data.get('status', '') == 'signed';
    }

    // HE ANH CU DA BO (13/11/2026): khong ai duoc ghi duong dan anh len dong
    // giao dich hay phieu nua. Anh chi nam o bang anh_chung_tu. Chan ca chu so
    // huu: may nao con chay ban app cu thi ghi hong ngay, khong lang le ghi
    // anh vao cho khong ai doc.
    function khongCoAnhTrenDong() {
      return !request.resource.data.keys().hasAny(['evidencePhotoUrl', 'evidencePhotoUrls']);
    }
    function khongCoAnhTrenPhieu() {
      return !request.resource.data.keys().hasAny(['signedPhotoUrls']);
    }

    // Ghi duoc chieu XUAT: xuat kho, hao hut, doi tac va diem ban.
    function ghiXuatKho() {
      return isToanQuyenKho() || (isSignedIn() && role() == 'XUAT_KHO');
    }

    // Giao dich nhap va xuat nam CHUNG mot bang, phan biet bang truong `type`.
    // Nen khong chan duoc theo bang, phai xet noi dung tung ban ghi.
    //
    // Ton dau ky tinh la NHAP vi no cung lam tang ton. Hao hut tinh la XUAT theo
    // yeu cau cua bo phan: keg giao thuc te 20,6 lit ma bien ban ghi tron 20,
    // phan le ay phat sinh dung luc giao hang.
    function laChieuNhap(t) {
      return t == 'IN' || t == 'OPENING';
    }

    function laChieuXuat(t) {
      return t == 'OUT' || t == 'LOSS';
    }

    // KE TOAN - lam duoc moi viec nghiep vu, ke ca THAO TAC DOANH THU.
    //
    // Xem doanh thu thi ai da duoc duyet cung xem: so lieu kinh doanh khong
    // phai bi mat voi nguoi trong nha. Nhung tao lenh xuat hoa don len SAP va
    // don so lieu thi chi ke toan - hoa don da phat hanh la da len co quan
    // thue, huy phai lam bien ban.
    function isAccountant() {
      return isOwner() || (isSignedIn() && role() == 'KE_TOAN');
    }

    // Doc du lieu chung. Giu ten cu de doc luat ben duoi khong phai nho mot bang
    // doi ten trong dau.
    function isViewer() {
      return isApproved();
    }

    // -------------------------------------------------------------------------
    // Ham kiem tra kieu va gioi han kich thuoc du lieu (chong DoS / type juggling)
    // -------------------------------------------------------------------------
    function reqStr(data, field, minLen, maxLen) {
      return field in data &&
        data[field] is string &&
        data[field].size() >= minLen &&
        data[field].size() <= maxLen;
    }

    function optStr(data, field, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function reqNum(data, field, minVal, maxVal) {
      return field in data &&
        data[field] is number &&
        data[field] >= minVal &&
        data[field] <= maxVal;
    }

    function optNum(data, field, minVal, maxVal) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function optBool(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] is bool;
    }

    // -------------------------------------------------------------------------
    // Domain Validators
    // -------------------------------------------------------------------------
    function userAllowedKeys() {
      return [
        'uid', 'email', 'name', 'photoURL', 'role',
        'createdAt', 'updatedAt', 'approvedBy', 'pinHash', 'pinSalt',
        'pinUpdatedAt', 'pinFailCount', 'pinLocked', 'pinMustChange'
      ];
    }

    function validRoles() {
      return [
        'OWNER', 'KE_TOAN', 'QUAN_LY_XUONG', 'SAN_XUAT',
        'NHAP_KHO', 'XUAT_KHO', 'DNC', 'PENDING'
      ];
    }

    function isValidUserCreate(data, uid) {
      return data.keys().hasOnly(userAllowedKeys())
        && reqStr(data, 'uid', 1, 128)
        && data.uid == uid
        && reqStr(data, 'email', 1, 254)
        && data.email == email()
        && reqStr(data, 'role', 1, 32)
        && data.role == 'PENDING'
        && optStr(data, 'name', 200)
        && optStr(data, 'photoURL', 2000)
        && optStr(data, 'createdAt', 64)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'approvedBy', 254)
        && optStr(data, 'pinHash', 512)
        && optStr(data, 'pinSalt', 128)
        && optStr(data, 'pinUpdatedAt', 64)
        && optNum(data, 'pinFailCount', 0, 5)
        && optBool(data, 'pinLocked')
        && optBool(data, 'pinMustChange')
        && (!('pinLocked' in data) || data.pinLocked == null || data.pinLocked == false)
        && (!('pinMustChange' in data) || data.pinMustChange == null || data.pinMustChange == false)
        && (!('pinFailCount' in data) || data.pinFailCount == null || data.pinFailCount == 0);
    }

    function isValidUserUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userAllowedKeys())
        && (!('uid' in resource.data) || data.get('uid', '') == resource.data.uid)
        && (!('email' in resource.data) || data.get('email', '') == resource.data.email)
        && reqStr(data, 'role', 1, 32)
        && (
          data.role == resource.data.get('role', '')
          || data.role in validRoles()
        )
        && optStr(data, 'name', 200)
        && optStr(data, 'photoURL', 2000)
        && optStr(data, 'createdAt', 64)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'approvedBy', 254)
        && optStr(data, 'pinHash', 512)
        && optStr(data, 'pinSalt', 128)
        && optStr(data, 'pinUpdatedAt', 64)
        && optNum(data, 'pinFailCount', 0, 5)
        && optBool(data, 'pinLocked')
        && optBool(data, 'pinMustChange');
    }

    // Chu ky dien tu (ChuKyDienTu) tren phieu nhap Paperless.
    function isValidChuKy(sig) {
      return sig is map
        && sig.keys().hasOnly(['name', 'email', 'uid', 'signedAt', 'token', 'note'])
        && sig.keys().hasAll(['name', 'email', 'signedAt', 'token'])
        && sig.name is string && sig.name.size() <= 150
        && sig.email is string && sig.email.size() <= 254
        && (!('uid' in sig) || sig.uid == null || (sig.uid is string && sig.uid.size() <= 128))
        && sig.signedAt is string && sig.signedAt.size() > 0 && sig.signedAt.size() <= 64
        && sig.token is string && sig.token.size() > 0 && sig.token.size() <= 64
        && (!('note' in sig) || sig.note == null || (sig.note is string && sig.note.size() <= 1000));
    }

    function optChuKy(data, field) {
      return !(field in data) || data[field] == null || isValidChuKy(data[field]);
    }

    function sigUidMatchesOnCreate(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || !('uid' in request.resource.data[field])
        || request.resource.data[field].uid == null
        || request.resource.data[field].uid == request.auth.uid;
    }

    function sigUidMatchesIfChanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || request.resource.data[field] == resource.data.get(field, null)
        || !('uid' in request.resource.data[field])
        || request.resource.data[field].uid == null
        || request.resource.data[field].uid == request.auth.uid;
    }

    function slipAllowedKeys() {
      return [
        'id', 'code', 'date', 'dateKey', 'seq', 'status',
        'printedAt', 'signedAt', 'signedBy', 'note',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
        'creatorSig', 'managerSig', 'warehouseSig',
        'rejectedBy', 'rejectedReason', 'rejectedAt'
      ];
    }

    function isValidSlipCommon(data, slipId) {
      return optStr(data, 'id', 64)
        && (!('id' in data) || data.id == null || data.id == slipId)
        && optStr(data, 'code', 64)
        && (!('code' in data) || data.code == null || data.code == slipId)
        && optStr(data, 'date', 32)
        && optStr(data, 'dateKey', 32)
        && optNum(data, 'seq', 0, 100000)
        && reqStr(data, 'status', 1, 32)
        && data.status in ['draft', 'printed', 'cho_ql_xuong', 'cho_kho_tong', 'tra_lai', 'signed']
        && optStr(data, 'printedAt', 64)
        && optStr(data, 'signedAt', 64)
        && optStr(data, 'signedBy', 254)
        && optStr(data, 'note', 2000)
        && optStr(data, 'createdAt', 64)
        && optStr(data, 'createdBy', 150)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'updatedBy', 150)
        && optChuKy(data, 'creatorSig')
        && optChuKy(data, 'managerSig')
        && optChuKy(data, 'warehouseSig')
        && optStr(data, 'rejectedBy', 254)
        && optStr(data, 'rejectedReason', 2000)
        && optStr(data, 'rejectedAt', 64);
    }

    function isValidSlipCreate(data, slipId) {
      return data.keys().hasOnly(slipAllowedKeys())
        && reqStr(data, 'code', 1, 64)
        && data.code == slipId
        && reqStr(data, 'date', 1, 32)
        && isValidSlipCommon(data, slipId)
        && (
          isToanQuyenKho()
          || (
            (duyetXuong() || data.get('managerSig', null) == null)
            && (duyetKhoTong() || data.get('warehouseSig', null) == null)
            && sigUidMatchesOnCreate('creatorSig')
            && sigUidMatchesOnCreate('managerSig')
            && sigUidMatchesOnCreate('warehouseSig')
          )
        );
    }

    function isValidSlipUpdate(data, slipId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(slipAllowedKeys())
        && isValidSlipCommon(data, slipId)
        && (!('id' in resource.data) || data.get('id', '') == resource.data.id)
        && (!('code' in resource.data) || data.get('code', '') == resource.data.code)
        && (
          isToanQuyenKho()
          || (
            (duyetXuong()
              || (!(data.status in ['cho_kho_tong', 'signed']) && data.get('managerSig', null) == null)
              || data.get('managerSig', null) == resource.data.get('managerSig', null))
            && (duyetKhoTong()
              || (data.status != 'signed' && data.get('warehouseSig', null) == null)
              || data.get('warehouseSig', null) == resource.data.get('warehouseSig', null))
            && (!(data.status in ['cho_kho_tong', 'signed'])
              || resource.data.get('creatorSig', null) == null
              || data.get('creatorSig', null) == resource.data.get('creatorSig', null))
            && sigUidMatchesIfChanged('creatorSig')
            && sigUidMatchesIfChanged('managerSig')
            && sigUidMatchesIfChanged('warehouseSig')
          )
        );
    }

    function keHoachAllowedKeys() {
      return [
        'id', 'date', 'productId', 'targetQty', 'batchHint',
        'source', 'note', 'createdBy', 'createdAt', 'updatedAt',
        'updatedBy', 'uid', 'published', 'productName', 'unit'
      ];
    }

    function isValidKeHoachSXCommon(data) {
      return optStr(data, 'id', 128)
        && reqStr(data, 'date', 8, 32)
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}.*')
        && reqStr(data, 'productId', 1, 64)
        && reqNum(data, 'targetQty', 0, 10000000)
        && optStr(data, 'batchHint', 128)
        && reqStr(data, 'source', 0, 128)
        && optStr(data, 'note', 2000)
        && reqStr(data, 'createdBy', 0, 150)
        && reqStr(data, 'createdAt', 1, 64)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'updatedBy', 150)
        && optStr(data, 'uid', 128)
        && optBool(data, 'published')
        && optStr(data, 'productName', 200)
        && optStr(data, 'unit', 50);
    }

    function isValidKeHoachSXCreate(data) {
      return data.keys().hasOnly(keHoachAllowedKeys())
        && isValidKeHoachSXCommon(data);
    }

    function isValidKeHoachSXUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keHoachAllowedKeys())
        && isValidKeHoachSXCommon(data)
        && (!('id' in resource.data) || !('id' in data) || data.id == resource.data.id);
    }

    // Truong phe duyet Giam sat xuong (danh_gia_sx, kiem_ke_bon, kiem_ke_keg).
    function isValidApprovalFields(data) {
      return optStr(data, 'approvalStatus', 32)
        && (
          !('approvalStatus' in data)
          || data.approvalStatus == null
          || data.approvalStatus in ['pending', 'approved', 'returned']
        )
        && optStr(data, 'approvedBy', 150)
        && optStr(data, 'approvedAt', 64)
        && optStr(data, 'rejectedReason', 500);
    }

    // THU TU QUAN TRONG: xet phan khong can vai tro TRUOC, duyetXuong() SAU.
    // Moi lan goi vai tro ton them mot loat phep tinh (exists + get), ma
    // Firestore chan cung o 1.000 phep tinh moi lan ghi. Ban dau dat
    // duyetXuong() len truoc thi MOI lan sua phieu (ke ca sua ghi chu) vuot
    // nguong va bi tu choi - do bang Rules test API 20/11/2026.
    function chuaDungTruongDuyetKhiTao(data) {
      return (
          data.get('approvalStatus', null) == null
          || data.get('approvalStatus', null) == 'pending'
        )
        && data.get('approvedBy', null) == null
        && data.get('approvedAt', null) == null
        && data.get('rejectedReason', null) == null;
    }

    // QUYEN THEO VAI TRO DA TRA SAN — y het isToanQuyenKho / ghiNhapKho /
    // ghiXuatKho / duyetXuong, nhung nhan vai tro `r` truyen vao thay vi tra
    // lai ho so nguoi dung moi lan. Ba bang dot nay (danh_gia_sx, kiem_ke_bon,
    // kiem_ke_keg) kiem nhieu dieu kien mot luc; tra vai tro chuc lan la vuot
    // nguong 1.000 phep tinh cua Firestore (do 20/11/2026).
    function toanQuyenR(r) {
      return isBootstrapOwner() || (isSignedIn() && emailVerified() && r == 'OWNER') || r == 'KE_TOAN';
    }
    function ghiNhapR(r) {
      return toanQuyenR(r) || r in ['NHAP_KHO', 'QUAN_LY_XUONG', 'SAN_XUAT'];
    }
    function ghiXuatR(r) {
      return toanQuyenR(r) || r == 'XUAT_KHO';
    }
    function duyetXuongR(r) {
      return toanQuyenR(r) || r == 'QUAN_LY_XUONG';
    }

    // Ghi ba bang Rao xuong: vai tro `r` tra mot lan o `allow`, truyen xuong.
    function coQuyenRaoXuong(r, viec) {
      let d = request.resource.data;
      return (viec == 'tao-dg' && ghiNhapR(r) && isValidDanhGiaSXCreate(d, r))
        || (viec == 'sua-dg' && ghiNhapR(r) && isValidDanhGiaSXUpdate(d, r))
        || (viec == 'tao-bon' && ghiNhapR(r) && isValidKiemKeBonCreate(d, r))
        || (viec == 'sua-bon' && ghiNhapR(r) && isValidKiemKeBonUpdate(d, r))
        || (viec == 'tao-keg' && isValidKiemKeKegCreate(d, r)
          && ((d.location == 'XUONG' && ghiNhapR(r))
            || (d.location == 'KHO_TONG' && (ghiNhapR(r) || ghiXuatR(r)))))
        || (viec == 'sua-keg' && isValidKiemKeKegUpdate(d, r)
          && (
            toanQuyenR(r)
            || (resource.data.get('location', '') == 'XUONG' && d.location == 'XUONG' && ghiNhapR(r))
            || (resource.data.get('location', '') == 'KHO_TONG' && d.location == 'KHO_TONG'
              && (ghiNhapR(r) || ghiXuatR(r)))
          ));
    }

    function canCreateApprovalFields(data, r) {
      return chuaDungTruongDuyetKhiTao(data) || duyetXuongR(r);
    }

    // Giu nguyen ket qua duyet, hoac chi dua ve 'pending' (gui lai sau khi sua).
    function giuNguyenTruongDuyet(data) {
      return (
          data.get('approvalStatus', null) == resource.data.get('approvalStatus', null)
          || data.get('approvalStatus', null) == 'pending'
        )
        && (
          data.get('approvedBy', null) == resource.data.get('approvedBy', null)
          || data.get('approvedBy', null) == null
        )
        && (
          data.get('approvedAt', null) == resource.data.get('approvedAt', null)
          || data.get('approvedAt', null) == null
        )
        && (
          data.get('rejectedReason', null) == resource.data.get('rejectedReason', null)
          || data.get('rejectedReason', null) == null
        );
    }

    function canUpdateApprovalFields(data, r) {
      return giuNguyenTruongDuyet(data) || duyetXuongR(r);
    }

    function danhGiaAllowedKeys() {
      return [
        'id', 'date', 'shift', 'productId', 'plannedQty',
        'actualBrewedQty', 'actualHandoverQty', 'lossQty',
        'rating', 'note', 'createdBy', 'createdAt',
        'updatedAt', 'updatedBy', 'uid', 'productName', 'unit',
        'approvalStatus', 'approvedBy', 'approvedAt', 'rejectedReason'
      ];
    }

    function isValidDanhGiaSXCommon(data) {
      return optStr(data, 'id', 128)
        && reqStr(data, 'date', 8, 32)
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}.*')
        && reqStr(data, 'shift', 1, 100)
        && reqStr(data, 'productId', 1, 64)
        && reqNum(data, 'plannedQty', 0, 10000000)
        && reqNum(data, 'actualBrewedQty', 0, 10000000)
        && optNum(data, 'actualHandoverQty', 0, 10000000)
        && optNum(data, 'lossQty', 0, 10000000)
        && reqStr(data, 'rating', 1, 100)
        && reqStr(data, 'note', 0, 2000)
        && reqStr(data, 'createdBy', 0, 150)
        && reqStr(data, 'createdAt', 1, 64)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'updatedBy', 150)
        && optStr(data, 'uid', 128)
        && optStr(data, 'productName', 200)
        && optStr(data, 'unit', 50)
        && isValidApprovalFields(data);
    }

    function isValidDanhGiaSXCreate(data, r) {
      return data.keys().hasOnly(danhGiaAllowedKeys())
        && isValidDanhGiaSXCommon(data)
        && canCreateApprovalFields(data, r);
    }

    function isValidDanhGiaSXUpdate(data, r) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(danhGiaAllowedKeys())
        && isValidDanhGiaSXCommon(data)
        && (!('id' in resource.data) || resource.data.id == null || data.get('id', null) == resource.data.id)
        && canUpdateApprovalFields(data, r);
    }

    function kiemKeBonAllowedKeys() {
      return [
        'id', 'month', 'tankId', 'tankGroup', 'productId',
        'batchNumber', 'liters', 'statusLabel', 'createdBy', 'createdAt',
        'updatedAt', 'updatedBy', 'uid', 'note', 'productName', 'tankName',
        'approvalStatus', 'approvedBy', 'approvedAt', 'rejectedReason'
      ];
    }

    function isValidKiemKeBonCommon(data) {
      return optStr(data, 'id', 128)
        && reqStr(data, 'month', 6, 20)
        && data.month.matches('^\\d{4}-\\d{2}.*')
        && reqStr(data, 'tankId', 1, 64)
        && reqStr(data, 'tankGroup', 3, 3)
        && data.tankGroup in ['FST', 'BBT']
        && reqStr(data, 'productId', 1, 64)
        && reqStr(data, 'batchNumber', 0, 128)
        && reqNum(data, 'liters', 0, 1000000)
        && optStr(data, 'statusLabel', 200)
        && reqStr(data, 'createdBy', 0, 150)
        && reqStr(data, 'createdAt', 1, 64)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'updatedBy', 150)
        && optStr(data, 'uid', 128)
        && optStr(data, 'note', 2000)
        && optStr(data, 'productName', 200)
        && optStr(data, 'tankName', 150)
        && isValidApprovalFields(data);
    }

    function isValidKiemKeBonCreate(data, r) {
      return data.keys().hasOnly(kiemKeBonAllowedKeys())
        && isValidKiemKeBonCommon(data)
        && canCreateApprovalFields(data, r);
    }

    function isValidKiemKeBonUpdate(data, r) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(kiemKeBonAllowedKeys())
        && isValidKiemKeBonCommon(data)
        && (!('id' in resource.data) || resource.data.id == null || data.get('id', null) == resource.data.id)
        && canUpdateApprovalFields(data, r);
    }

    function kiemKeKegAllowedKeys() {
      return [
        'id', 'date', 'shiftOrPeriod', 'location', 'items',
        'totalKegs', 'totalLiters', 'note', 'createdBy', 'createdAt',
        'updatedAt', 'updatedBy', 'uid',
        'approvalStatus', 'approvedBy', 'approvedAt', 'rejectedReason'
      ];
    }

    function isValidKiemKeKegCommon(data) {
      return optStr(data, 'id', 128)
        && reqStr(data, 'date', 8, 32)
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}.*')
        && optStr(data, 'shiftOrPeriod', 100)
        && reqStr(data, 'location', 4, 16)
        && data.location in ['XUONG', 'KHO_TONG']
        && 'items' in data && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && reqNum(data, 'totalKegs', 0, 1000000)
        && reqNum(data, 'totalLiters', 0, 10000000)
        && optStr(data, 'note', 2000)
        && reqStr(data, 'createdBy', 0, 150)
        && reqStr(data, 'createdAt', 1, 64)
        && optStr(data, 'updatedAt', 64)
        && optStr(data, 'updatedBy', 150)
        && optStr(data, 'uid', 128)
        && isValidApprovalFields(data);
    }

    function isValidKiemKeKegCreate(data, r) {
      return data.keys().hasOnly(kiemKeKegAllowedKeys())
        && isValidKiemKeKegCommon(data)
        && canCreateApprovalFields(data, r);
    }

    function isValidKiemKeKegUpdate(data, r) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(kiemKeKegAllowedKeys())
        && isValidKiemKeKegCommon(data)
        && (!('id' in resource.data) || resource.data.id == null || data.get('id', null) == resource.data.id)
        && canUpdateApprovalFields(data, r);
    }

    // -------------------------------------------------------------------------
    // Ho so nguoi dung
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Tu doc ho so cua minh (de biet da duoc duyet chua); chu so huu doc tat ca.
      allow get: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // Nguoi moi dang nhap tu tao duoc ho so, NHUNG chi o trang thai CHO DUYET
      // va phai dung email cua chinh minh. Khong the tu dat vai tro cao hon.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isValidUserCreate(request.resource.data, uid);

      // Chu so huu: sua duoc moi thu (vai tro, dat lai PIN...); nhung neu chinh
      // chu so huu dang bi khoa PIN (pinLocked == true) thi tu mo khoa hoac doi
      // pinHash bat buoc phai co phien dang nhap Google moi trong vong 10 phut
      // (chu so huu KHAC van dat lai duoc tu Cai dat).
      // Nguoi dung thuong: CHI sua duoc cac truong PIN cua chinh minh theo 3
      // nhanh hep va bat buoc giu nguyen role. Nho affectedKeys().hasOnly(...)
      // nen khong the loi dung viec dat PIN de tu nang quyen len OWNER.
      //
      // Mot chu so huu KHONG ha duoc vai tro cua chu so huu GOC. Gio co nhieu
      // hon mot chu so huu, thieu cau nay thi nguoi duoc cap quyen co the ha
      // quyen nguoi da cap cho minh - va neu do la nguoi cuoi cung con quyen
      // thi khong ai vao lai duoc nua. Chu so huu goc thi luon vao duoc, vi
      // quyen cua ho tinh theo email chu khong theo tai lieu nay.
      allow update: if isValidUserUpdate(request.resource.data) && (
        (
          isOwner()
          && !(
            resource.data.get('email', '') == ownerEmail()
            && request.resource.data.get('role', '') != 'OWNER'
          )
          && (
            !(
              request.auth.uid == uid
              && resource.data.get('pinLocked', false) == true
              && (
                request.resource.data.get('pinLocked', false) != true
                || request.resource.data.get('pinHash', null) != resource.data.get('pinHash', null)
              )
            )
            || hasFreshGoogleAuth()
          )
        )
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (
            // (a) Dat moi hoac dat lai PIN cua chinh minh
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['pinHash', 'pinSalt', 'pinUpdatedAt', 'pinFailCount', 'pinLocked', 'pinMustChange'])
              && reqStr(request.resource.data, 'pinHash', 1, 512)
              && reqStr(request.resource.data, 'pinSalt', 1, 128)
              && reqStr(request.resource.data, 'pinUpdatedAt', 1, 64)
              && request.resource.data.get('pinFailCount', 0) == 0
              && request.resource.data.get('pinLocked', false) == false
              && request.resource.data.get('pinMustChange', false) == false
              && (
                (
                  resource.data.get('pinHash', null) == null
                  && resource.data.get('pinLocked', false) != true
                )
                || (
                  resource.data.get('pinMustChange', false) == true
                  && resource.data.get('pinLocked', false) != true
                )
                || hasFreshGoogleAuth()
              )
            )
            // (b) Ghi nhan lan nhap sai PIN (tang tung +1 toi da 5, cham 5 tu khoa)
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['pinFailCount', 'pinLocked'])
              && resource.data.get('pinLocked', false) != true
              && 'pinFailCount' in request.resource.data
              && request.resource.data.pinFailCount is int
              && request.resource.data.pinFailCount == (
                ('pinFailCount' in resource.data && resource.data.pinFailCount is int)
                  ? resource.data.pinFailCount
                  : 0
              ) + 1
              && request.resource.data.pinFailCount >= 1
              && request.resource.data.pinFailCount <= 5
              && (
                (
                  request.resource.data.pinFailCount >= 5
                  && request.resource.data.get('pinLocked', false) == true
                )
                || (
                  request.resource.data.pinFailCount < 5
                  && request.resource.data.get('pinLocked', false) == false
                )
              )
            )
            // (c) Dat lai bo dem sai ve 0 khi nhap dung PIN (chi khi chua bi khoa)
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['pinFailCount', 'pinLocked'])
              && resource.data.get('pinLocked', false) != true
              && 'pinFailCount' in request.resource.data
              && request.resource.data.pinFailCount is int
              && request.resource.data.pinFailCount == 0
              && request.resource.data.get('pinLocked', false) == false
            )
          )
        )
      );

      // Cung ly do tren: khong xoa duoc ho so cua chu so huu goc.
      allow delete: if isOwner()
        && resource.data.get('email', '') != ownerEmail();
    }

    // -------------------------------------------------------------------------
    // Du lieu nghiep vu
    // -------------------------------------------------------------------------
    match /test/connection {
      allow read: if isSignedIn();
    }

    /*
     * CHO DUY NHAT LUAT CHAN CA PHAN XEM.
     *
     * DNC chi doc duoc giao dich chieu XUAT. Nhung Firestore khong loc tung tai
     * lieu khi tra ve mot danh sach: no xet CAU TRUY VAN. Neu luat doi
     * `resource.data.type` thi truy van phai co rang buoc tuong ung, khong thi
     * Firestore tu choi CA truy van chu khong tra ve mot phan.
     *
     * Nen ung dung phai truy van kem `where('type','in',['OUT','LOSS'])` khi
     * nguoi dang nhap la DNC. Xem cho dang ky transactions trong src/App.tsx —
     * hai ben phai khop nhau, lech mot ben la DNC mo app len thay man hinh loi.
     */
    match /transactions/{transactionId} {
      allow read: if xemKho()
        || (laDNC() && laChieuXuat(resource.data.get('type', '')));

      // Ghi theo CHIEU cua chinh ban ghi do.
      allow create: if khongCoAnhTrenDong() && (
        isToanQuyenKho()
        || (ghiNhapKho() && laChieuNhap(request.resource.data.get('type', '')))
        || (ghiXuatKho() && laChieuXuat(request.resource.data.get('type', '')))
      );

      // Sua thi xet CA HAI: loai cu va loai moi. Chi xet loai moi thi nguoi
      // nhap kho doi mot phieu xuat thanh phieu nhap la sua duoc no; chi xet
      // loai cu thi doi phieu nhap thanh phieu xuat.
      allow update: if khongCoAnhTrenDong() && (
        isToanQuyenKho()
        || (
          ghiNhapKho()
          && laChieuNhap(resource.data.get('type', ''))
          && laChieuNhap(request.resource.data.get('type', ''))
        )
        || (
          ghiXuatKho()
          && laChieuXuat(resource.data.get('type', ''))
          && laChieuXuat(request.resource.data.get('type', ''))
        )
      );

      // XOA: CHI ADMIN (21/10/2026, Khoa quyet). Truoc day nguoi xuat kho xoa
      // duoc don dang di duong. Nay xoa du lieu la xoa luon anh tren Cloudinary,
      // ma xoa anh chi admin lam duoc - nen xoa du lieu cung chi admin.
      //
      // NGOAI LE DUY NHAT (30/10/2026, Khoa chot): nguoi nhap kho xoa duoc dong
      // NHAP cua mot phieu CHUA KY - nhap sai so luong roi xoa lam lai. Phieu
      // chua ky (draft, printed, cho_ql_xuong, cho_kho_tong, tra_lai) thi hang
      // chua vao ton, xoa khong mat ton kho. Phieu da ky ('signed'): chi admin.
      allow delete: if isOwner()
        || (
          ghiNhapKho()
          && resource.data.get('type', '') == 'IN'
          && resource.data.get('slipCode', '') != ''
          && !phieuDaKy(resource.data.slipCode)
        );
    }

    // Doanh thu: MOI NGUOI XEM, CHI KE TOAN THAO TAC.
    //
    // Nguyen tac van la KHOP DUNG BANG GIAO DIEN - lech ben nao cung sinh loi:
    // luat chat hon giao dien thi nguoi dung lam xong moi bi tu choi; luat rong
    // hon giao dien thi mo DevTools la lam duoc thu ma man hinh khong cho.
    //
    // Xem: ai da duoc duyet. Sua/xoa: ke toan.
    match /revenue/{recordId} {
      // Doanh thu khong phai viec cua DNC.
      allow read: if xemKho();
      allow create, update: if isAccountant();
      // Xoa: chi admin, nhu moi bang khac.
      allow delete: if isOwner();
    }

    // Lenh xuat hoa don len SAP: ai da duoc duyet cung xem duoc tien do, nhung
    // chi ke toan tao va doi trang thai lenh.
    //
    // Khong cap quyen cho may chay script: script doc tep .json tai ve chu khong
    // doc Firestore. Lam cach kia thi phai cap khoa tai khoan dich vu cho may -
    // them mot bi mat nua phai quan, va khoa do ghi duoc MOI collection.
    //
    // Khong cho xoa: mot lenh da xuat hoa don la dau vet phai giu. Muon bo thi
    // chuyen trang thai sang 'cancelled', van con thay ai huy va vi sao.
    match /sap_jobs/{jobId} {
      // Lenh xuat hoa don la viec noi bo cua ke toan, DNC khong doc.
      allow read: if xemKho();
      allow create, update: if isAccountant();
      allow delete: if false;
    }

    /*
     * Bang gan diem ban -> doi tac, dung khi nap xuat kho tu file BBGN.
     *
     * Khoa tai lieu la ten diem ban da chuan hoa, nen gan lai cung mot diem ban
     * la ghi de len chinh no. Khong cho xoa: xoa mot dong gan lam hang cua diem
     * do am tham roi khoi lan nap sau, ma khong co gi bao.
     */
    match /diem_ban/{key} {
      // DNC doc duoc: bang nay dich ten diem ban ra don vi, khong co no thi don
      // xuat hien ra khong biet cua ai.
      allow read: if isViewer();
      // Gan diem ban -> doi tac la viec cua nguoi xuat kho.
      allow create, update: if ghiXuatKho();
      allow delete: if false;
    }

    /*
     * HOA DON DA GHI SO.
     *
     * XOA: CHI CHU SO HUU, va do la mot noi long co chu dich (28/09/2026).
     *
     * Truoc day cam tiet (`if false`) vi to hoa don da phat hanh la chung tu
     * da len co quan thue — xoa la mat dau vet. Nhung dong chi tiet cua hoa
     * don KHONG duoc luu: chung dung lai tu giao dich xuat kho. Nen khi du
     * lieu xuat kho bi xoa (nap nham roi don lai chang han), ban ghi hoa don
     * nam lai vinh vien, tra cuu bao "khong dung lai duoc dong nao", va khong
     * co duong nao don — ke ca khi do chi la so thu nghiem.
     *
     * Chi mo cho CHU SO HUU, khong mo cho ke toan: ke toan van tao va sua
     * duoc so hoa don (viec hang ngay), con xoa la viec hiem va nang, phai
     * dung mot nguoi chiu trach nhiem.
     */
    match /hoa_don/{key} {
      allow read: if isApproved();
      allow create, update: if isAccountant();
      allow delete: if isOwner();
    }

    /*
     * ANH CHUNG TU (dung lai 13/11/2026) — nguon duy nhat cua moi anh minh chung.
     *
     * Moi tam anh mot tai lieu, moc vao CHUNG TU (ma phieu nhap PN-..., hoac ma
     * chuyen giao referenceGroupId, hoac ma kiem ke bon) qua truong chungTu.
     * Dong giao dich va phieu khong giu duong dan anh nao, nen khong luot ghi
     * nghiep vu nao lam roi anh duoc. Xem src/anh/moHinh.ts.
     *
     * Doc: ai xem duoc kho doc het; DNC chi doc anh chieu xuat.
     * Tao: chi THEM, dung chieu cua minh, ghi dung uid cua chinh nguoi tai, chi
     *   duong dan Cloudinary, va phai gan it nhat mot chung tu. Ghi de mot tam
     *   da co la update — chi admin.
     * Sua, XOA: CHI ADMIN. Xoa ban ghi la buoc cuoi cua xoa anh that — tep tren
     *   Cloudinary do may chu xoa sau cua requireOwner (api/anh/xoa.ts).
     */
    match /anh_chung_tu/{id} {
      allow read: if xemKho()
        || (laDNC() && resource.data.get('loai', '') == 'XUAT');
      allow create: if isSignedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('url', '').matches('^https://res[.]cloudinary[.]com/[^/]+/image/upload/.+')
        && request.resource.data.get('chungTu', []) is list
        && request.resource.data.get('chungTu', []).size() > 0
        && (
          (request.resource.data.get('loai', '') == 'NHAP' && ghiNhapKho())
          || (request.resource.data.get('loai', '') == 'XUAT' && ghiXuatKho())
        );
      allow update, delete: if isOwner();
    }

    // So anh doi truoc (anh_minh_chung): da chuyen het sang anh_chung_tu, giu
    // lai lam ban doi chieu. Chi admin doc, khong ai ghi.
    match /anh_minh_chung/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    /*
     * BO DO LUOT GOI FIREBASE — moi ngay (gio My) mot tai lieu.
     *
     * Moi may da duoc duyet tu gui so luot doc / ghi / xoa cua minh len, nam
     * phut mot lan, bang phep cong don (increment). Chi cho dung nam truong
     * do — khong ai ghi duoc thu gi khac vao day. Xoa: chi admin.
     * Xem src/lib/doLuong.ts.
     */
    match /do_luong/{ngay} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && request.resource.data.keys().hasOnly(['doc', 'ghi', 'xoa', 'capNhat', 'nguoi']);
      allow delete: if isOwner();
    }

    match /partners/{partnerId} {
      allow read: if isViewer();
      // Them va sua don vi nhan hang la viec cua nguoi xuat kho.
      allow create, update: if ghiXuatKho();
      allow delete: if isOwner();
    }

    // Phieu nhap kho — LUONG PAPERLESS 2 BUOC RAO (Xưởng -> QL Xưởng -> Kho Tổng).
    //
    // Noi dung dong hang suy ra tu `transactions` co cung `slipCode`.
    // Anh hien trang Keg / anh to phieu ky nam o `anh_chung_tu`.
    //
    // Quy trinh trang thai:
    //   1. NV San Xuat lap phieu (`cho_ql_xuong`, hoac luong cu `draft`/`printed`).
    //      Khong duoc tu duyet len `cho_kho_tong` hay `signed`.
    //   2. Quan Ly Xuong duyet Rao 1 (`cho_ql_xuong`/`draft`/`printed` ->
    //      `cho_kho_tong`), hoac tra lai (`tra_lai`). Khong duoc tu duyet Rao 2.
    //   3. Kho Tong (`NHAP_KHO`) duyet Rao 2 (`cho_kho_tong`, hoac phieu cu
    //      `draft`/`printed` -> `signed`), hoac tra lai (`tra_lai`). KHONG duoc
    //      duyet Rao 1 (`cho_kho_tong`) va KHONG duoc bo qua Rao 1 tu
    //      `cho_ql_xuong` nhay thang len `signed` (chi OWNER/KE_TOAN moi vuot rao).
    //   4. Phieu da ky (`signed`): CHI OWNER moi ha trang thai duoc.
    match /slips/{slipId} {
      // Phieu nhap la chuyen cua kho va xuong, DNC khong doc.
      allow read: if xemKho();

      allow create: if khongCoAnhTrenPhieu()
        && isValidSlipCreate(request.resource.data, slipId)
        && (
          isToanQuyenKho()
          || (duyetXuong() && request.resource.data.status in ['draft', 'printed', 'cho_ql_xuong', 'cho_kho_tong'])
          || (duyetKhoTong() && request.resource.data.status in ['draft', 'printed', 'cho_ql_xuong', 'signed'])
          || (ghiNhapKho() && request.resource.data.status in ['draft', 'printed', 'cho_ql_xuong'])
        );

      allow update: if khongCoAnhTrenPhieu()
        && isValidSlipUpdate(request.resource.data, slipId)
        && !(resource.data.get('status', '') == 'signed'
             && request.resource.data.get('status', '') != 'signed'
             && !isOwner())
        && (
          isToanQuyenKho()
          || (
            duyetXuong()
            && (
              (
                resource.data.get('status', '') in ['cho_ql_xuong', 'draft', 'printed', 'tra_lai']
                && request.resource.data.get('status', '') == 'cho_kho_tong'
              )
              || (
                resource.data.get('status', '') in ['cho_ql_xuong', 'draft', 'printed', 'cho_kho_tong']
                && request.resource.data.get('status', '') == 'tra_lai'
              )
            )
          )
          || (
            duyetKhoTong()
            && (
              (
                resource.data.get('status', '') in ['cho_kho_tong', 'draft', 'printed']
                && request.resource.data.get('status', '') in ['signed', 'tra_lai']
              )
              || (
                resource.data.get('status', '') == 'signed'
                && request.resource.data.get('status', '') == 'signed'
              )
            )
          )
          || (
            ghiNhapKho()
            && (
              (
                resource.data.get('status', '') in ['draft', 'printed', 'tra_lai', 'cho_ql_xuong']
                && request.resource.data.get('status', '') == 'cho_ql_xuong'
              )
              || (
                resource.data.get('status', '') in ['draft', 'printed']
                && request.resource.data.get('status', '') == 'printed'
              )
            )
          )
        );

      // Phieu chua ky: nguoi ghi nhap kho xoa duoc (xem luat transactions).
      allow delete: if isOwner()
        || (ghiNhapKho() && resource.data.get('status', '') != 'signed');
    }

    // -------------------------------------------------------------------------
    // Ke hoach san xuat (Quan ly xuong / Ke toan / Owner nap -> ke thua cho
    // NV San Xuat va Dashboard doi chieu).
    // -------------------------------------------------------------------------
    match /ke_hoach_sx/{planId} {
      allow read: if xemKho();
      allow create: if duyetXuong() && isValidKeHoachSXCreate(request.resource.data);
      allow update: if duyetXuong() && isValidKeHoachSXUpdate(request.resource.data);
      allow delete: if duyetXuong();
    }

    // -------------------------------------------------------------------------
    // Danh gia san luong san xuat theo ca / ngay tai Xuong.
    // -------------------------------------------------------------------------
    match /danh_gia_sx/{evalId} {
      allow read: if xemKho();
      allow create: if coQuyenRaoXuong(role(), 'tao-dg');
      allow update: if coQuyenRaoXuong(role(), 'sua-dg');
      allow delete: if isOwner() || duyetXuong();
    }

    // -------------------------------------------------------------------------
    // Kiem ke thang bon len men (FST) va bon thanh pham (BBT).
    // -------------------------------------------------------------------------
    match /kiem_ke_bon/{invId} {
      allow read: if xemKho();
      allow create: if coQuyenRaoXuong(role(), 'tao-bon');
      allow update: if coQuyenRaoXuong(role(), 'sua-bon');
      allow delete: if isOwner() || duyetXuong();
    }

    // -------------------------------------------------------------------------
    // Kiem ke keg & lit tai Xuong (XUONG) va Kho Tong (KHO_TONG).
    // -------------------------------------------------------------------------
    match /kiem_ke_keg/{invId} {
      allow read: if xemKho();
      allow create: if coQuyenRaoXuong(role(), 'tao-keg');
      allow update: if coQuyenRaoXuong(role(), 'sua-keg');
      allow delete: if isOwner()
        || (resource.data.get('location', '') == 'XUONG' && duyetXuong());
    }

    /*
     * SO SO PHIEU - moi phieu nhap / xuat kho mot so co dinh.
     *
     * Khoa tai lieu = so phieu (51260001...). Quy tac danh so o
     * src/lib/soPhieu.ts, phan cap so chong trung o src/lib/soPhieuKho.ts.
     *
     * KHONG AI XOA DUOC, ke ca chu so huu (tru lenh don sach cua owner). So
     * chung tu da cap thi da in ra giay / ghi so; xoa mot dong la nhay so, va
     * so nhay so la cau hoi dau tien cua kiem toan. Huy mot phieu thi sinh PHIEU
     * HUY ghi am, phieu goc van nam nguyen trong so.
     *
     * KHONG SUA DUOC SO PHIEU, ngay ca chu so huu: doi so tren mot chung tu la
     * lam sai lech chung tu. Chi cho phep DOI TRANG THAI sang da_huy (kem so
     * phieu da huy no) - dung mot duong duy nhat de mot phieu ngung hieu luc.
     *
     * Doc thi ai xem duoc kho deu doc: tra mot so phieu la viec ai trong kho
     * cung phai lam duoc. DNC khong doc - so phieu la chuyen noi bo cua kho.
     */
    match /so_phieu/{soPhieu} {
      allow read: if xemKho();
      allow create: if ghiNhapKho() || ghiXuatKho();
      // Chi duoc danh dau da huy. Moi truong khac phai giu nguyen.
      allow update: if (ghiNhapKho() || ghiXuatKho())
        && request.resource.data.soPhieu == resource.data.soPhieu
        && request.resource.data.loai == resource.data.loai
        && request.resource.data.documentDate == resource.data.documentDate
        && request.resource.data.enteredOn == resource.data.enteredOn
        && request.resource.data.nguon == resource.data.nguon
        && request.resource.data.soLuong == resource.data.soLuong
        && request.resource.data.trangThai == 'da_huy';

      /*
       * XOA - CHI CHU SO HUU.
       *
       * Truoc day la `if false`: so chung tu khong xoa duoc gi het. Nhung co
       * hai viec that can toi no, va ca hai deu la viec cua chu so huu:
       *
       *   1. DOI SO PHIEU NHAP KIEU CU sang dung ma phieu in ra giay.
       *   2. DON SACH HE THONG.
       */
      allow delete: if isOwner();
    }

    /*
     * BO DEM SO PHIEU - mot tai lieu cho moi (dau so x nam), giu so ke tiep.
     *
     * Phai ghi duoc trong cung giao dich voi lan cap so, nen ai ghi duoc kho
     * thi ghi duoc day. Xoa: chi chu so huu (phuc vu lenh don sach he thong).
     */
    match /bo_dem/{khoa} {
      allow read: if xemKho();
      allow create, update: if ghiNhapKho() || ghiXuatKho();
      allow delete: if isOwner();
    }

    // Tu choi mac dinh moi duong dan khong duoc khai bao o tren.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
