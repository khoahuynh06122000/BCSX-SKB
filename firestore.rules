rules_version = '2';

// =============================================================================
// QUY TAC PHAN QUYEN - BiaLogistics
//
// Nguyen tac cot loi: KHONG BAO GIO quyet dinh quyen dua tren tai lieu ma
// chinh nguoi dung ghi duoc.
//
// Ban cu pham dung loi nay: ham isOwner() doc vai tro tu user_sessions/{uid},
// ma tai lieu do lai cho phep chinh nguoi dung ghi -> ai cung tu phong minh
// lam OWNER duoc. Ban nay xac dinh chu so huu bang EMAIL trong ID token do
// Google cap, khong the gia mao.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Email cua chu so huu. Chi tai khoan Google nay moi duyet duoc nguoi dung.
    function ownerEmail() {
      return 'khoa.huynh.06.12.2000@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.get('email', '');
    }

    // Bat buoc email da xac minh: chan truong hop tao tai khoan voi email
    // nguoi khac ma chua chung minh quyen so huu hop thu.
    function emailVerified() {
      return request.auth.token.get('email_verified', false);
    }

    // Chu so huu GOC - xac dinh bang email trong ID token do Google cap, khong
    // the gia mao. Day la tai khoan khong bao gio bi khoa ra ngoai duoc.
    function isBootstrapOwner() {
      return isSignedIn() && emailVerified() && email() == ownerEmail();
    }

    // Chu so huu = chu so huu goc, HOAC nguoi duoc dat vai tro OWNER trong
    // users/{uid}.
    //
    // Doc vai tro tu tai lieu nguoi dung nghe giong dung cai loi ban cu mac
    // phai, nhung KHAC HAN o mot diem quyet dinh: users/{uid} khong phai tai
    // lieu chinh nguoi dung ghi duoc vai tro. Xem lai luat ben duoi:
    //   - create bat buoc role == 'PENDING'
    //   - update cua chinh minh chi cham duoc pinHash/pinUpdatedAt va bat buoc
    //     giu nguyen role
    // Nen chi chu so huu moi nang vai tro cho nguoi khac duoc. Ban cu doc tu
    // user_sessions/{uid} - tai lieu ma ai cung tu ghi de len duoc - do moi la
    // cho hong.
    function isOwner() {
      return isBootstrapOwner() ||
        (isSignedIn() && emailVerified() && role() == 'OWNER');
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'PENDING')
        : 'PENDING';
    }

    // -------------------------------------------------------------------------
    // MOI TAI KHOAN DA DUOC DUYET DEU DUNG DUOC TOAN BO PHAN HE.
    //
    // Truoc day chia ba muc: VIEWER chi doc, STAFF ghi duoc kho, OWNER them
    // doanh thu. Nay chu so huu quyet dinh bo phan cap: da vao duoc app thi
    // dung het chuc nang, vi hai lop dang nhap Google + ma PIN da du chan
    // nguoi ngoai.
    //
    // CANH CUA THAT SU CON LAI LA BUOC DUYET. Tai khoan Google nao cung dang
    // nhap duoc, nhung vao thi o trang thai PENDING va PENDING KHONG doc ghi
    // duoc gi ca - phai co chu so huu bam duyet. Ai bo canh cua do thi ca the
    // gioi ghi duoc vao so kho nay.
    //
    // HAI VIEC VAN RIENG CHU SO HUU, co y giu lai:
    //   - Doi vai tro nguoi dung: mo ra thi nguoi vua duoc duyet lai di duyet
    //     nguoi khac, canh cua duy nhat con lai tu no mo toang.
    //   - Xoa du lieu: sai mot lan la mat, khong lay lai duoc.
    function isApproved() {
      return isOwner() ||
        (isSignedIn() &&
          (role() == 'KE_TOAN' || role() == 'STAFF' || role() == 'VIEWER' ||
           role() == 'NHAP_KHO' || role() == 'XUAT_KHO'));
    }

    // -------------------------------------------------------------------------
    // HAI VAI TRO MOT CHIEU (27/08/2026)
    //
    // NHAP_KHO chi ghi duoc chieu nhap, XUAT_KHO chi ghi duoc chieu xuat. Ca hai
    // VAN XEM DUOC HET: ton kho, bao cao, lich su deu tron ca hai chieu nen chan
    // xem thi nguoi nhap kho khong tra noi mot lo hang.
    //
    // Ba vai tro cu (VIEWER, STAFF, KE_TOAN) GIU NGUYEN quyen ghi ca hai chieu.
    // Ha quyen mot tai khoan dang chay viec thi hom sau co nguoi khong lam duoc
    // viec ma khong hieu vi sao; muon siet ai thi doi vai tro nguoi do.
    //
    // Phai khop dung voi src/lib/quyen.ts - do la bang giao dien dung de an hien
    // nut. Lech ben nao cung sinh loi.
    // -------------------------------------------------------------------------

    // Ghi duoc CA HAI CHIEU: chu so huu, ke toan, va hai vai tro cu.
    function isToanQuyenKho() {
      return isOwner() ||
        (isSignedIn() &&
          (role() == 'KE_TOAN' || role() == 'STAFF' || role() == 'VIEWER'));
    }

    // Ghi duoc chieu NHAP: nhap kho, ton dau ky, phieu nhap va anh phieu da ky.
    function ghiNhapKho() {
      return isToanQuyenKho() || (isSignedIn() && role() == 'NHAP_KHO');
    }

    // Ghi duoc chieu XUAT: xuat kho, hao hut, doi tac va diem ban.
    function ghiXuatKho() {
      return isToanQuyenKho() || (isSignedIn() && role() == 'XUAT_KHO');
    }

    // Giao dich nhap va xuat nam CHUNG mot bang, phan biet bang truong `type`.
    // Nen khong chan duoc theo bang, phai xet noi dung tung ban ghi.
    //
    // Ton dau ky tinh la NHAP vi no cung lam tang ton. Hao hut tinh la XUAT theo
    // yeu cau cua bo phan: keg giao thuc te 20,6 lit ma bien ban ghi tron 20,
    // phan le ay phat sinh dung luc giao hang.
    function laChieuNhap(t) {
      return t == 'IN' || t == 'OPENING';
    }

    function laChieuXuat(t) {
      return t == 'OUT' || t == 'LOSS';
    }

    // KE TOAN - lam duoc moi viec nghiep vu, ke ca THAO TAC DOANH THU.
    //
    // Xem doanh thu thi ai da duoc duyet cung xem: so lieu kinh doanh khong
    // phai bi mat voi nguoi trong nha. Nhung tao lenh xuat hoa don len SAP va
    // don so lieu thi chi ke toan - hoa don da phat hanh la da len co quan
    // thue, huy phai lam bien ban.
    function isAccountant() {
      return isOwner() || (isSignedIn() && role() == 'KE_TOAN');
    }

    // Doc du lieu: ai da duoc duyet cung xem duoc, ke ca hai vai tro mot chieu.
    // Giu ten cu de doc luat ben duoi khong phai nho mot bang doi ten trong dau.
    function isViewer() {
      return isApproved();
    }

    // -------------------------------------------------------------------------
    // Ho so nguoi dung
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Tu doc ho so cua minh (de biet da duoc duyet chua); chu so huu doc tat ca.
      allow get: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // Nguoi moi dang nhap tu tao duoc ho so, NHUNG chi o trang thai CHO DUYET
      // va phai dung email cua chinh minh. Khong the tu dat vai tro cao hon.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'PENDING'
        && request.resource.data.email == email();

      // Chu so huu: sua duoc moi thu (vai tro, dat lai PIN...).
      // Nguoi dung thuong: CHI sua duoc dung 2 o pinHash/pinUpdatedAt cua
      // chinh minh, va vai tro bat buoc giu nguyen. Nho dieu kien
      // affectedKeys().hasOnly(...) nen khong the loi dung viec dat PIN de
      // tu nang quyen len OWNER.
      //
      // Mot chu so huu KHONG ha duoc vai tro cua chu so huu GOC. Gio co nhieu
      // hon mot chu so huu, thieu cau nay thi nguoi duoc cap quyen co the ha
      // quyen nguoi da cap cho minh - va neu do la nguoi cuoi cung con quyen
      // thi khong ai vao lai duoc nua. Chu so huu goc thi luon vao duoc, vi
      // quyen cua ho tinh theo email chu khong theo tai lieu nay.
      allow update: if (
          isOwner()
          && !(
            resource.data.get('email', '') == ownerEmail()
            && request.resource.data.get('role', '') != 'OWNER'
          )
        )
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pinHash', 'pinUpdatedAt'])
          && request.resource.data.role == resource.data.role
        );

      // Cung ly do tren: khong xoa duoc ho so cua chu so huu goc.
      allow delete: if isOwner()
        && resource.data.get('email', '') != ownerEmail();
    }

    // -------------------------------------------------------------------------
    // Du lieu nghiep vu
    // -------------------------------------------------------------------------
    match /test/connection {
      allow read: if isSignedIn();
    }

    match /transactions/{transactionId} {
      allow read: if isViewer();

      // Ghi theo CHIEU cua chinh ban ghi do.
      allow create: if isToanQuyenKho()
        || (ghiNhapKho() && laChieuNhap(request.resource.data.get('type', '')))
        || (ghiXuatKho() && laChieuXuat(request.resource.data.get('type', '')));

      // Sua thi xet CA HAI: loai cu va loai moi. Chi xet loai moi thi nguoi
      // nhap kho doi mot phieu xuat thanh phieu nhap la sua duoc no; chi xet
      // loai cu thi doi phieu nhap thanh phieu xuat.
      allow update: if isToanQuyenKho()
        || (
          ghiNhapKho()
          && laChieuNhap(resource.data.get('type', ''))
          && laChieuNhap(request.resource.data.get('type', ''))
        )
        || (
          ghiXuatKho()
          && laChieuXuat(resource.data.get('type', ''))
          && laChieuXuat(request.resource.data.get('type', ''))
        );

      // Xoa la viec khong lay lai duoc nen van siet: nguoi thuong chi xoa duoc
      // phieu dang tren duong van chuyen, thu chua vao so ton kho. Don di duong
      // la viec cua chieu xuat.
      allow delete: if isOwner() ||
        (ghiXuatKho() && resource.data.get('status', '') == 'in_transit');
    }

    // Doanh thu: MOI NGUOI XEM, CHI KE TOAN THAO TAC.
    //
    // Nguyen tac van la KHOP DUNG BANG GIAO DIEN - lech ben nao cung sinh loi:
    // luat chat hon giao dien thi nguoi dung lam xong moi bi tu choi; luat rong
    // hon giao dien thi mo DevTools la lam duoc thu ma man hinh khong cho.
    //
    // Xem: ai da duoc duyet. Sua/xoa: ke toan.
    match /revenue/{recordId} {
      allow read: if isApproved();
      allow create, update, delete: if isAccountant();
    }

    // Lenh xuat hoa don len SAP: ai da duoc duyet cung xem duoc tien do, nhung
    // chi ke toan tao va doi trang thai lenh.
    //
    // Khong cap quyen cho may chay script: script doc tep .json tai ve chu khong
    // doc Firestore. Lam cach kia thi phai cap khoa tai khoan dich vu cho may -
    // them mot bi mat nua phai quan, va khoa do ghi duoc MOI collection.
    //
    // Khong cho xoa: mot lenh da xuat hoa don la dau vet phai giu. Muon bo thi
    // chuyen trang thai sang 'cancelled', van con thay ai huy va vi sao.
    match /sap_jobs/{jobId} {
      allow read: if isApproved();
      allow create, update: if isAccountant();
      allow delete: if false;
    }

    /*
     * Bảng gán điểm bán -> đối tác, dùng khi nạp xuất kho từ file BBGN.
     *
     * Khoá tài liệu là tên điểm bán đã chuẩn hoá, nên gán lại cùng một điểm bán
     * là ghi đè lên chính nó. Không cho xoá: xoá một dòng gán làm hàng của điểm
     * đó âm thầm rơi khỏi lần nạp sau, mà không có gì báo.
     */
    match /diem_ban/{key} {
      allow read: if isViewer();
      // Gan diem ban -> doi tac la viec cua nguoi xuat kho.
      allow create, update: if ghiXuatKho();
      allow delete: if false;
    }

    /*
     * So hoa don da phat hanh, do nguoi dung dien lai sau khi xuat hoa don.
     *
     * Khoa tai lieu suy tu bien dot va ma BP nen dien lai la ghi de len chinh
     * no. KHONG CHO XOA: mot so hoa don da phat hanh la chung tu da len co
     * quan thue: dien nham thi sua lai, khong xoa dau vet.
     */
    match /hoa_don/{key} {
      allow read: if isApproved();
      allow create, update: if isAccountant();
      allow delete: if false;
    }

    match /partners/{partnerId} {
      allow read: if isViewer();
      // Them va sua don vi nhan hang la viec cua nguoi xuat kho.
      allow create, update: if ghiXuatKho();
      allow delete: if isOwner();
    }

    // Phieu nhap kho: chi luu trang thai va anh da ky, noi dung suy ra tu
    // transactions nen khong so lech hai nguon.
    //
    // ANH KY LA THU LAM TANG TON KHO. Hang chi vao ton khi phieu co anh to giay
    // da ky (xem src/lib/slip.ts), nen viec them/bot anh o day co suc nang bang
    // viec sua truc tiep so ton.
    //
    // Nhan vien PHAI them duoc anh - do la viec cua kho. Nhung KHONG duoc BOT:
    // go het anh la keo ca lo hang ra khoi ton kho. Giao dien chi hien nut go
    // cho chu so huu, nhung giao dien khong phai lop bao ve - mo DevTools goi
    // Firestore truc tiep la lam duoc. Dieu kien duoi day chan that: so anh sau
    // khi sua khong duoc it hon truoc khi sua, tru khi la chu so huu.
    match /slips/{slipId} {
      allow read: if isViewer();
      allow create: if ghiNhapKho();
      allow update: if isOwner()
        || (
          ghiNhapKho()
          && request.resource.data.get('signedPhotoUrls', []).size()
               >= resource.data.get('signedPhotoUrls', []).size()
        );
      allow delete: if isOwner();
    }
  }
}
